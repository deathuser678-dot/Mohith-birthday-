<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Happy Birthday Mohith 🎂</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  min-height: 100vh;
  font-family: "Poppins", Arial, sans-serif;
  background: linear-gradient(135deg, #ffd6e7, #fff0f6, #ffe4ef);
  overflow-x: hidden;
  color: #5b2340;
}

.screen {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 25px;
}

.card {
  width: min(92%, 600px);
  background: rgba(255,255,255,.72);
  backdrop-filter: blur(12px);
  border-radius: 30px;
  padding: 35px 25px;
  text-align: center;
  box-shadow: 0 20px 60px rgba(120,40,75,.18);
  border: 1px solid rgba(255,255,255,.8);
}

h1 {
  font-size: clamp(32px, 8vw, 55px);
  margin-bottom: 12px;
}

h2 {
  font-size: 30px;
  margin-bottom: 15px;
}

p {
  font-size: 17px;
  line-height: 1.7;
}

button {
  border: none;
  padding: 14px 28px;
  border-radius: 30px;
  background: #e94f88;
  color: white;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
  margin-top: 22px;
  box-shadow: 0 8px 20px rgba(233,79,136,.3);
  transition: .2s;
}

button:hover {
  transform: scale(1.05);
}

.hidden {
  display: none !important;
}

/* Photo selection */
.photo-box {
  margin: 20px auto;
  width: 180px;
  height: 180px;
  border-radius: 25px;
  overflow: hidden;
  border: 4px solid white;
  box-shadow: 0 10px 30px rgba(0,0,0,.15);
  background: #ffe5ef;
}

.photo-box img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

input[type="file"] {
  display: none;
}

.choose {
  display: inline-block;
  padding: 12px 20px;
  border-radius: 25px;
  background: #fff;
  color: #d63873;
  font-weight: bold;
  cursor: pointer;
}

/* Countdown */
.countdown {
  font-size: 110px;
  font-weight: 900;
  color: #e83e7b;
  animation: pop .8s ease;
}

@keyframes pop {
  0% { transform: scale(.2); opacity: 0; }
  70% { transform: scale(1.2); }
  100% { transform: scale(1); opacity: 1; }
}

/* Surprise */
#surprise {
  position: relative;
}

.big-name {
  font-size: clamp(45px, 12vw, 80px);
  font-weight: 900;
  color: #e83e7b;
  text-shadow: 0 5px 15px rgba(232,62,123,.2);
}

.cake {
  font-size: 90px;
  margin: 10px;
  animation: bounce 1s infinite alternate;
}

@keyframes bounce {
  to { transform: translateY(-10px); }
}

.message {
  background: rgba(255,255,255,.65);
  border-radius: 22px;
  padding: 20px;
  margin-top: 20px;
}

.heart {
  position: fixed;
  bottom: -30px;
  font-size: 25px;
  animation: float 6s linear forwards;
  pointer-events: none;
}

@keyframes float {
  0% {
    transform: translateY(0) rotate(0);
    opacity: 1;
  }
  100% {
    transform: translateY(-110vh) rotate(360deg);
    opacity: 0;
  }
}

.confetti {
  position: fixed;
  width: 9px;
  height: 14px;
  top: -20px;
  animation: fall 4s linear forwards;
  pointer-events: none;
}

@keyframes fall {
  to {
    transform: translateY(110vh) rotate(720deg);
  }
}
</style>
</head>

<body>

<!-- START -->
<section class="screen" id="start">
  <div class="card">
    <div style="font-size:60px;">🎀</div>

    <h1>Something Special...</h1>

    <p>
      I made a little surprise just for you, Mohith. 💗
      <br>
      But first... choose your favorite picture!
    </p>

    <div class="photo-box">
      <img id="preview"
           src="https://placehold.co/400x400/ffe5ef/e83e7b?text=Your+Photo">
    </div>

    <label class="choose" for="photo">
      📸 Choose Mohith's Photo
    </label>

    <input id="photo" type="file" accept="image/*">

    <br>

    <button onclick="startCountdown()">
      Open My Surprise 💌
    </button>
  </div>
</section>


<!-- COUNTDOWN -->
<section class="screen hidden" id="countdownScreen">
  <div class="card">
    <p>Get ready...</p>
    <div class="countdown" id="countdownNumber">3</div>
    <p>Something special is coming! ✨</p>
  </div>
</section>


<!-- SURPRISE -->
<section class="screen hidden" id="surprise">
  <div class="card">

    <div style="font-size:45px;">🎉🎈🎉</div>

    <div class="cake">🎂</div>

    <p style="font-size:22px;">SURPRISE!</p>

    <div class="big-name">
      Happy Birthday
      <br>
      Mohith! 💗
    </div>

    <div class="photo-box">
      <img id="finalPhoto"
           src="https://placehold.co/400x400/ffe5ef/e83e7b?text=Happy+Birthday">
    </div>

    <div class="message">
      <p>
        ✨ Today is all about you! ✨
        <br><br>
        May your birthday be filled with
        happiness, laughter, beautiful memories,
        and everything that makes you smile. 💕
        <br><br>
        Keep shining, keep smiling,
        and have the most amazing birthday ever! 🎂
        <br><br>
        💗 Happy Birthday, Mohith! 💗
      </p>
    </div>

    <button onclick="makeItExtraSpecial()">
      One More Surprise 💝
    </button>

    <p id="extra" class="hidden" style="margin-top:20px;font-size:20px;">
      🌸 You deserve all the happiness in the world! 🌸
      <br>
      🎁 May all your wishes come true! 🎁
    </p>

  </div>
</section>


<script>

const photoInput = document.getElementById("photo");
const preview = document.getElementById("preview");
const finalPhoto = document.getElementById("finalPhoto");

photoInput.addEventListener("change", function() {

  const file = this.files[0];

  if (file) {
    const imageURL = URL.createObjectURL(file);

    preview.src = imageURL;
    finalPhoto.src = imageURL;
  }
});


function startCountdown() {

  document.getElementById("start").classList.add("hidden");
  document.getElementById("countdownScreen").classList.remove("hidden");

  let number = 3;
  const countdown = document.getElementById("countdownNumber");

  countdown.textContent = number;

  const timer = setInterval(() => {

    number--;

    if (number > 0) {
      countdown.textContent = number;

      countdown.style.animation = "none";
      void countdown.offsetWidth;
      countdown.style.animation = "pop .8s ease";

    } else {

      countdown.textContent = "🎉";

      setTimeout(() => {

        document.getElementById("countdownScreen")
          .classList.add("hidden");

        document.getElementById("surprise")
          .classList.remove("hidden");

        startHearts();
        startConfetti();

      }, 900);

      clearInterval(timer);
    }

  }, 1000);
}


function startHearts() {

  setInterval(() => {

    const heart = document.createElement("div");

    heart.className = "heart";

    const hearts = ["💗","💕","💖","💓","💘","🌸"];

    heart.textContent =
      hearts[Math.floor(Math.random() * hearts.length)];

    heart.style.left = Math.random() * 100 + "vw";
    heart.style.animationDuration =
      (4 + Math.random() * 4) + "s";

    document.body.appendChild(heart);

    setTimeout(() => heart.remove(), 8000);

  }, 400);
}


function startConfetti() {

  for (let i = 0; i < 100; i++) {

    const piece = document.createElement("div");

    piece.className = "confetti";

    piece.style.left = Math.random() * 100 + "vw";

    piece.style.background =
      `hsl(${Math.random() * 360}, 80%, 65%)`;

    piece.style.animationDelay =
      Math.random() * 2 + "s";

    piece.style.transform =
      `rotate(${Math.random() * 360}deg)`;

    document.body.appendChild(piece);

    setTimeout(() => piece.remove(), 6000);
  }
}


function makeItExtraSpecial() {

  document.getElementById("extra")
    .classList.remove("hidden");

  startConfetti();

}

</script>

</body>
</html>
